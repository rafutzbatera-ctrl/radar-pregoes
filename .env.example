# Extrator de habilitação (M3) — plugável:
#   heuristico  = regras locais, SEM IA (padrão; não precisa de chave)
#   api         = Anthropic API via instructor (precisa de ANTHROPIC_API_KEY)
#   claude_cli  = Claude Code CLI headless (precisa do CLI instalado/logado)
RADAR_EXTRATOR=heuristico

# Chave da Anthropic API — só é necessária no modo RADAR_EXTRATOR=api.
# Runtime do app — NÃO é a assinatura do agente de código.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado na extração estruturada (modo api, via instructor)
RADAR_LLM_MODEL=claude-sonnet-4-6

# Modo claude_cli: binário do Claude Code e timeout (segundos)
RADAR_CLAUDE_CLI=claude
RADAR_CLAUDE_CLI_TIMEOUT=600

# Liga/desliga o agendador (2x/dia). Em testes fica desligado.
RADAR_SCHEDULER=1

# Caminho do banco (relativo à raiz do projeto)
RADAR_DB=data/radar.db
